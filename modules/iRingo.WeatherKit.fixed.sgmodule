#!name =  iRingo: 🌤 WeatherKit β
#!desc = 【李佳静（老婆）定制版：参数已全部内置，无需任何设置】\nBETA: iOS 18 & macOS 15 & watchOS 11\n1.解锁全部天气功能\n2.修改空气质量数据\n3.修改下一小时降水数据\n4.修改天气数据\n5.修改天气预警数据
#!openUrl = http://boxjs.com/#/app/iRingo.WeatherKit.beta
#!author = VirgilClyne[https://github.com/VirgilClyne],WordlessEcho[https://github.com/WordlessEcho],001[https://github.com/001ProMax],hhh2210[https://github.com/hhh2210]
#!homepage = https://NSRingo.github.io/guide/Weather/weather-kit
#!icon = https://developer.apple.com/assets/elements/icons/weatherkit/weatherkit-128x128.png
#!category =  iRingo
#!date = 2026-11-11 23:48:00
#!version = dev

[Rule]
DOMAIN,weather-analytics-events.apple.com,REJECT-DROP
DOMAIN-SUFFIX,tthr.apple.com,REJECT-DROP,extended-matching
DOMAIN,tether.edge.apple,REJECT-DROP,extended-matching

[Script]
🌤 WeatherKit.api.v1.availability.response = type=http-response, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v1\/availability\/, requires-body=1, engine=webview, debug=1, script-path=https://gist.githubusercontent.com/VirgilClyne/862db28df04be7523476d10b61b128f2/raw/response.dev.bundle.js, argument=DataSets="airQuality,currentWeather,forecastDaily,forecastHourly,forecastNextHour,news,weatherAlerts,weatherChange,trendComparison,locationInfo"&Weather.Replace="CN"&Weather.Provider="WeatherKit"&WeatherAlerts.Provider="QWeatherWeb"&NextHour.Provider="ColorfulClouds"&AirQuality.Current.Pollutants.Provider="ColorfulClouds"&AirQuality.Current.Pollutants.Units.Replace=""&AirQuality.Current.Pollutants.Units.Mode="Scale"&AirQuality.Current.Index.Replace="HJ6332012"&AirQuality.Current.Index.Provider="ColorfulCloudsUS"&AirQuality.Current.Index.ForceCNPrimaryPollutants="true"&AirQuality.Comparison.ReplaceWhenCurrentChange="false"&AirQuality.Comparison.Yesterday.PollutantsProvider="QWeather"&AirQuality.Comparison.Yesterday.IndexProvider="ColorfulCloudsUS"&AirQuality.Calculate.Algorithm="EU_EAQI"&AirQuality.Calculate.AllowOverRange="true"&API.ColorfulClouds.Token=""&API.QWeather.Host="devapi.qweather.com"&API.QWeather.Token=""&API.WAQI.Token=""&Storage="Argument"&LogLevel="WARN"
🌤 WeatherKit.api.v1.weatherAlerts.html.request = type=http-request, pattern="^https?:\/\/weatherkit\.apple\.com\/api\/v1\/weatherAlerts\?[^#]*&ids=[^&#]*-[0-9]{9}(?:&|$)", engine=webview, debug=1, script-path=https://gist.githubusercontent.com/VirgilClyne/862db28df04be7523476d10b61b128f2/raw/request.dev.bundle.js, argument=DataSets="airQuality,currentWeather,forecastDaily,forecastHourly,forecastNextHour,news,weatherAlerts,weatherChange,trendComparison,locationInfo"&Weather.Replace="CN"&Weather.Provider="WeatherKit"&WeatherAlerts.Provider="QWeatherWeb"&NextHour.Provider="ColorfulClouds"&AirQuality.Current.Pollutants.Provider="ColorfulClouds"&AirQuality.Current.Pollutants.Units.Replace=""&AirQuality.Current.Pollutants.Units.Mode="Scale"&AirQuality.Current.Index.Replace="HJ6332012"&AirQuality.Current.Index.Provider="ColorfulCloudsUS"&AirQuality.Current.Index.ForceCNPrimaryPollutants="true"&AirQuality.Comparison.ReplaceWhenCurrentChange="false"&AirQuality.Comparison.Yesterday.PollutantsProvider="QWeather"&AirQuality.Comparison.Yesterday.IndexProvider="ColorfulCloudsUS"&AirQuality.Calculate.Algorithm="EU_EAQI"&AirQuality.Calculate.AllowOverRange="true"&API.ColorfulClouds.Token=""&API.QWeather.Host="devapi.qweather.com"&API.QWeather.Token=""&API.WAQI.Token=""&Storage="Argument"&LogLevel="WARN"
🌤 WeatherKit.api.v1.weatherAlerts.api.request = type=http-request, pattern="^https?:\/\/weatherkit\.apple\.com\/api\/v1\/weatherAlerts\?[^#]*&ids=-?[0-9]+(?:\.[0-9]+)?,-?[0-9]+(?:\.[0-9]+)?(?:&|$)", engine=webview, debug=1, script-path=https://gist.githubusercontent.com/VirgilClyne/862db28df04be7523476d10b61b128f2/raw/request.dev.bundle.js, argument=DataSets="airQuality,currentWeather,forecastDaily,forecastHourly,forecastNextHour,news,weatherAlerts,weatherChange,trendComparison,locationInfo"&Weather.Replace="CN"&Weather.Provider="WeatherKit"&WeatherAlerts.Provider="QWeatherWeb"&NextHour.Provider="ColorfulClouds"&AirQuality.Current.Pollutants.Provider="ColorfulClouds"&AirQuality.Current.Pollutants.Units.Replace=""&AirQuality.Current.Pollutants.Units.Mode="Scale"&AirQuality.Current.Index.Replace="HJ6332012"&AirQuality.Current.Index.Provider="ColorfulCloudsUS"&AirQuality.Current.Index.ForceCNPrimaryPollutants="true"&AirQuality.Comparison.ReplaceWhenCurrentChange="false"&AirQuality.Comparison.Yesterday.PollutantsProvider="QWeather"&AirQuality.Comparison.Yesterday.IndexProvider="ColorfulCloudsUS"&AirQuality.Calculate.Algorithm="EU_EAQI"&AirQuality.Calculate.AllowOverRange="true"&API.ColorfulClouds.Token=""&API.QWeather.Host="devapi.qweather.com"&API.QWeather.Token=""&API.WAQI.Token=""&Storage="Argument"&LogLevel="WARN"

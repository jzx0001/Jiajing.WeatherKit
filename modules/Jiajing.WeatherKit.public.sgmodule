#!name = Jiajing ❤️ Jianbo 🌤 WeatherKit β（公共版）
#!desc = 【公共版 · 李佳静（老婆）维护：零配置，参数已全部内置，无需任何设置；AQI 空气质量指数美标显示，天气数据透传修复体感温度不显示】\n完整功能（体感守卫回填、分钟降水文案兜底）见老公专用定制版\nBETA: iOS 18 & macOS 15 & watchOS 11\n1.解锁全部天气功能\n2.修改空气质量数据\n3.修改下一小时降水数据\n4.修改天气数据\n5.修改天气预警数据
#!openUrl = http://boxjs.com/#/app/iRingo.WeatherKit.beta
#!author = VirgilClyne[https://github.com/VirgilClyne],WordlessEcho[https://github.com/WordlessEcho],001[https://github.com/001ProMax],hhh2210[https://github.com/hhh2210]
#!homepage = https://NSRingo.github.io/guide/Weather/weather-kit
#!icon = https://developer.apple.com/assets/elements/icons/weatherkit/weatherkit-128x128.png
#!category = ❤️ Jiajing 公共版
#!date = 2026-11-12 07:57:06
#!version = 1.0.0

[Rule]
DOMAIN,weather-analytics-events.apple.com,REJECT-DROP
DOMAIN-SUFFIX,tthr.apple.com,REJECT-DROP,extended-matching
DOMAIN,tether.edge.apple,REJECT-DROP,extended-matching

[Script]
🌤 WeatherKit.api.v1.availability.response = type=http-response, pattern=^https?:\/\/weatherkit\.apple\.com\/api\/v1\/availability\/, requires-body=1, engine=webview, debug=1, script-path=https://gist.githubusercontent.com/jzx0001/19bafbc51be1a5617f0c4f57236ff1a2/raw/response.public.bundle.js, argument=DataSets="airQuality,currentWeather,forecastDaily,forecastHourly,forecastNextHour,news,weatherAlerts,weatherChange,trendComparison,locationInfo"&Weather.Replace="CN"&Weather.Provider="WeatherKit"&WeatherAlerts.Provider="QWeatherWeb"&NextHour.Provider="ColorfulClouds"&AirQuality.Current.Pollutants.Provider="ColorfulClouds"&AirQuality.Current.Pollutants.Units.Replace=""&AirQuality.Current.Pollutants.Units.Mode="Scale"&AirQuality.Current.Index.Replace="HJ6332012"&AirQuality.Current.Index.Provider="ColorfulCloudsUS"&AirQuality.Current.Index.ForceCNPrimaryPollutants="true"&AirQuality.Comparison.ReplaceWhenCurrentChange="false"&AirQuality.Comparison.Yesterday.PollutantsProvider="QWeather"&AirQuality.Comparison.Yesterday.IndexProvider="ColorfulCloudsUS"&AirQuality.Calculate.Algorithm="EU_EAQI"&AirQuality.Calculate.AllowOverRange="true"&API.ColorfulClouds.Token=""&API.QWeather.Host="devapi.qweather.com"&API.QWeather.Token=""&API.WAQI.Token=""&Storage="Argument"&LogLevel="WARN"
🌤 WeatherKit.api.v1.weatherAlerts.html.request = type=http-request, pattern="^https?:\/\/weatherkit\.apple\.com\/api\/v1\/weatherAlerts\?[^#]*&ids=[^&#]*-[0-9]{9}(?:&|$)", engine=webview, debug=1, script-path=https://gist.githubusercontent.com/jzx0001/b6a0d38cb0496073778db7978737abe6/raw/request.public.bundle.js, argument=DataSets="airQuality,currentWeather,forecastDaily,forecastHourly,forecastNextHour,news,weatherAlerts,weatherChange,trendComparison,locationInfo"&Weather.Replace="CN"&Weather.Provider="WeatherKit"&WeatherAlerts.Provider="QWeatherWeb"&NextHour.Provider="ColorfulClouds"&AirQuality.Current.Pollutants.Provider="ColorfulClouds"&AirQuality.Current.Pollutants.Units.Replace=""&AirQuality.Current.Pollutants.Units.Mode="Scale"&AirQuality.Current.Index.Replace="HJ6332012"&AirQuality.Current.Index.Provider="ColorfulCloudsUS"&AirQuality.Current.Index.ForceCNPrimaryPollutants="true"&AirQuality.Comparison.ReplaceWhenCurrentChange="false"&AirQuality.Comparison.Yesterday.PollutantsProvider="QWeather"&AirQuality.Comparison.Yesterday.IndexProvider="ColorfulCloudsUS"&AirQuality.Calculate.Algorithm="EU_EAQI"&AirQuality.Calculate.AllowOverRange="true"&API.ColorfulClouds.Token=""&API.QWeather.Host="devapi.qweather.com"&API.QWeather.Token=""&API.WAQI.Token=""&Storage="Argument"&LogLevel="WARN"
